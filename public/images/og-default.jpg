<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" fill="none">
  <!-- Background -->
  <rect width="1200" height="630" fill="#FAFAF9"/>
  
  <!-- Decorative elements -->
  <circle cx="100" cy="100" r="80" fill="#FEF3C7" opacity="0.5"/>
  <circle cx="1100" cy="530" r="120" fill="#FEF3C7" opacity="0.3"/>
  
  <!-- Main content area -->
  <g transform="translate(100, 150)">
    <!-- Badge -->
    <rect x="0" y="0" width="280" height="48" rx="24" fill="#FEF3C7"/>
    <text x="140" y="32" text-anchor="middle" font-family="system-ui, sans-serif" font-weight="700" font-size="18" fill="#D97706">PROTECCIÓN PATRIMONIAL</text>
    
    <!-- Title -->
    <text x="0" y="100" font-family="system-ui, sans-serif" font-weight="800" font-size="56" fill="#1E293B" text-anchor="start">
      <tspan x="0">¿Tu patrimonio está</tspan>
      <tspan x="0" dy="64">realmente protegido?</tspan>
    </text>
    
    <!-- Subtitle -->
    <text x="0" y="220" font-family="system-ui, sans-serif" font-weight="400" font-size="24" fill="#64748B" text-anchor="start">
      <tspan x="0">Aseguramos lo que más valorás con estrategias</tspan>
      <tspan x="0" dy="36">personalizadas diseñadas por expertos</tspan>
    </text>
    
    <!-- CTA Buttons -->
    <rect x="0" y="290" width="260" height="56" rx="12" fill="#D97706"/>
    <text x="130" y="328" text-anchor="middle" font-family="system-ui, sans-serif" font-weight="700" font-size="18" fill="white">Solicitar Asesoría</text>
    
    <rect x="280" y="290" width="260" height="56" rx="12" fill="none" stroke="#D97706" stroke-width="3"/>
    <text x="410" y="328" text-anchor="middle" font-family="system-ui, sans-serif" font-weight="700" font-size="18" fill="#D97706">Explorar Coberturas</text>
  </g>
  
  <!-- Brand bottom -->
  <g transform="translate(100, 520)">
    <text x="0" y="0" font-family="system-ui, sans-serif" font-weight="800" font-size="32" fill="#1E293B">Ase de la Cruz</text>
    <text x="0" y="36" font-family="system-ui, sans-serif" font-weight="600" font-size="16" fill="#D97706">.</text>
    <text x="0" y="64" font-family="system-ui, sans-serif" font-weight="400" font-size="14" fill="#64748B">Asesoramiento experto en seguros desde 2004</text>
  </g>
  
  <!-- Right side decorative -->
  <g transform="translate(750, 100)">
    <rect x="0" y="0" width="350" height="430" rx="24" fill="white" stroke="#E2E8F0" stroke-width="2"/>
    <rect x="20" y="20" width="310" height="200" rx="16" fill="#FEF3C7"/>
    <text x="195" y="130" text-anchor="middle" font-family="system-ui, sans-serif" font-weight="700" font-size="20" fill="#D97706">🛡️</text>
    <text x="195" y="180" text-anchor="middle" font-family="system-ui, sans-serif" font-weight="600" font-size="16" fill="#1E293B">Coberturas</text>
    <text x="195" y="210" text-anchor="middle" font-family="system-ui, sans-serif" font-weight="400" font-size="14" fill="#64748B" textLength="280">Vida • Hogar • Auto • Empresas • ART</text>
    
    <g transform="translate(30, 250)">
      <rect x="0" y="0" width="130" height="130" rx="16" fill="#FEF3C7"/>
      <text x="65" y="60" text-anchor="middle" font-family="system-ui, sans-serif" font-weight="700" font-size="14" fill="#D97706">SALUD</text>
      <text x="65" y="80" text-anchor="middle" font-family="system-ui, sans-serif" font-weight="700" font-size="14" fill="#D97706">VIDA</text>
    </g>
    <g transform="translate(190, 250)">
      <rect x="0" y="0" width="130" height="130" rx="16" fill="#FEF3C7"/>
      <text x="65" y="60" text-anchor="middle" font-family="system-ui, sans-serif" font-weight="700" font-size="14" fill="#D97706">HOGAR</text>
      <text x="65" y="80" text-anchor="middle" font-family="system-ui, sans-serif" font-weight="700" font-size="14" fill="#D97706">AUTO</text>
    </g>
    <g transform="translate(30, 300)">
      <rect x="0" y="0" width="290" height="60" rx="12" fill="#D97706"/>
      <text x="145" y="40" text-anchor="middle" font-family="system-ui, sans-serif" font-weight="700" font-size="16" fill="white">EMPRESAS + ART</text>
    </g>
  </g>
</svg>