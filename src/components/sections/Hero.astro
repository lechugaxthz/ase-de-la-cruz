---
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  primaryCTA?: { label: string; href: string };
  secondaryCTA?: { label: string; href: string };
  backgroundImage?: string;
  backgroundPosition?: 'left' | 'center' | 'right';
  minHeight?: string;
  class?: string;
}
---
{{
  const {
    badge = 'Protección Patrimonial',
    title,
    subtitle,
    primaryCTA = { label: 'Solicitar Asesoría', href: '/contacto' },
    secondaryCTA = { label: 'Explorar Coberturas', href: '/servicios' },
    backgroundImage = 'https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&q=80&w=1920',
    backgroundPosition = 'right',
    minHeight = 'min-h-[90vh]',
    class: className = '',
  } = Astro.props;
}}
<section id="inicio" class={`relative flex items-center ${minHeight} ${className}`} aria-labelledby="hero-title">
  <!-- Background -->
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-gradient-to-r from-surface via-surface/80 to-transparent z-10"></div>
    <img
      class="w-full h-full object-cover"
      src={backgroundImage}
      alt=""
      loading="eager"
      fetchpriority="high"
      style={`object-position: ${backgroundPosition} center;`}
    />
  </div>

  <!-- Content -->
  <Container>
    <div class="relative z-20 max-w-2xl mt-20 lg:mt-0 animate-in">
      {badge && (
        <span class="text-primary font-bold text-sm uppercase tracking-widest mb-4 block">
          {badge}
        </span>
      )}
      <h1 id="hero-title" class="text-4xl sm:text-5xl lg:text-6xl font-heading font-extrabold mb-6 leading-tight text-dark">
        {title}
      </h1>
      {subtitle && (
        <p class="text-muted text-lg sm:text-xl mb-10 leading-relaxed max-w-xl">
          {subtitle}
        </p>
      )}
      <div class="flex flex-col sm:flex-row gap-4">
        <Button variant="primary" size="lg" href={primaryCTA.href} icon={primaryCTA.icon} iconPosition="right">
          {primaryCTA.label}
        </Button>
        {secondaryCTA && (
          <Button variant="outline" size="lg" href={secondaryCTA.href} icon={secondaryCTA.icon} iconPosition="right">
            {secondaryCTA.label}
          </Button>
        )}
      </div>
    </div>
  </Container>
</section>