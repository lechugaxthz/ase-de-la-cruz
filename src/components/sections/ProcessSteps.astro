---
import Container from '../ui/Container.astro';

interface Step {
  number: number;
  title: string;
  description: string;
  icon: string;
  bgColor: string;
  iconColor: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  steps: Step[];
  class?: string;
}
---
{{
  const {
    title = 'Nuestro Método',
    subtitle = 'Un proceso probado de 4 pasos para proteger tu patrimonio sin complicaciones',
    steps,
    class: className = '',
  } = Astro.props;
}}
<section id="metodo" class={`py-16 sm:py-24 lg:py-32 bg-surface ${className}`} aria-labelledby="method-title">
  <Container>
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="method-title" class="text-3xl sm:text-4xl font-heading font-extrabold text-dark mb-4">
        {title}
      </h2>
      {subtitle && (
        <p class="text-muted text-lg leading-relaxed">
          {subtitle}
        </p>
      )}
    </div>

    <!-- Steps Grid -->
    <div class="relative grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-6">
      <!-- Connector Line (Desktop only) -->
      <div class="hidden lg:block absolute top-[60px] left-[12%] right-[12%] h-0.5 bg-primary/20 z-0"></div>

      {steps.map((step, index) => (
        <div
          class="relative z-10 flex flex-col items-center text-center animate-in"
          style={`animation-delay: ${index * 150}ms`}
        >
          <!-- Circle with Icon -->
          <div
            class="w-24 h-24 rounded-full flex items-center justify-center mb-6 shadow-md group-hover:scale-105 transition-transform duration-300"
            style={`background-color: ${step.bgColor}`}
          >
            <span class="material-symbols-outlined text-4xl" style={`color: ${step.iconColor}`}>
              {step.icon}
            </span>
          </div>

          <!-- Step Number -->
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-white border-4 flex items-center justify-center text-sm font-bold text-primary shadow-sm"
               style={`border-color: ${step.bgColor}`}>
            {step.number}
          </div>

          <!-- Title -->
          <h3 class="text-xl font-heading font-bold text-dark mb-3">
            {step.title}
          </h3>

          <!-- Description -->
          <p class="text-muted text-sm leading-relaxed max-w-xs">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </Container>
</section>