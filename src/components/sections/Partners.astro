---
import Container from '../ui/Container.astro';

interface Partner {
  name: string;
  logo: string;
  featured?: boolean;
}

interface Props {
  partners: Partner[];
  title?: string;
  subtitle?: string;
  class?: string;
}

const { partners, title = 'Confían en nosotros', subtitle, class: className = '' } = Astro.props;
---

<section id="partners" class={`py-16 sm:py-24 bg-surface ${className}`} aria-labelledby="partners-title">
  <Container>
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="partners-title" class="text-3xl sm:text-4xl font-heading font-extrabold text-dark mb-4">
        {title}
      </h2>
      {subtitle && (
        <p class="text-muted text-lg leading-relaxed">
          {subtitle}
        </p>
      )}
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 items-center">
      {partners.map((partner, index) => (
        <div class="animate-in opacity-60 hover:opacity-100 transition-opacity duration-300 grayscale hover:grayscale-0"
             style={{ animationDelay: `${index * 100}ms` }}>
          <img
            src={partner.logo}
            alt={partner.name}
            class="mx-auto max-h-12 md:max-h-16 w-auto object-contain"
            loading="lazy"
            width="120"
            height="60"
          />
        </div>
      ))}
    </div>
  </Container>
</section>
