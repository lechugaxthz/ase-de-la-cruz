---
interface Props {
  children: any;
  href?: string;
  variant?: 'primary' | 'outline' | 'ghost' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  loading?: boolean;
  icon?: string;
  iconPosition?: 'left' | 'right';
  fullWidth?: boolean;
}
---
{{
  const {
    children,
    href,
    variant = 'primary',
    size = 'md',
    class: className = '',
    type = 'button',
    disabled = false,
    loading = false,
    icon,
    iconPosition = 'left',
    fullWidth = false,
  } = Astro.props;

  const baseClasses = `
    inline-flex items-center justify-center gap-2 font-semibold rounded-lg
    transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2
    disabled:opacity-50 disabled:cursor-not-allowed active:scale-[0.98]
  `;

  const variantClasses = {
    primary: 'bg-primary text-white hover:bg-primary-hover focus:ring-primary/30 shadow-sm',
    outline: 'border-2 border-primary text-primary hover:bg-primary-light focus:ring-primary/30',
    ghost: 'text-primary hover:bg-primary-light focus:ring-primary/30',
    danger: 'bg-error text-white hover:bg-red-700 focus:ring-error/30',
  };

  const sizeClasses = {
    sm: 'px-3 py-1.5 text-sm gap-1.5',
    md: 'px-6 py-3 text-base',
    lg: 'px-8 py-4 text-lg gap-2',
  };

  const widthClass = fullWidth ? 'w-full' : '';
  const classList = [baseClasses, variantClasses[variant], sizeClasses[size], widthClass, className].join(' ');
}}

{{
  const Icon = icon ? `<span class="material-symbols-outlined">{icon}</span>` : '';
  const iconBefore = icon && iconPosition === 'left' ? Icon : '';
  const iconAfter = icon && iconPosition === 'right' ? Icon : '';
  const loader = loading ? `<svg class="animate-spin h-5 w-5" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/></svg>` : '';
}}

{{
  if (href) {
    return `<a href="${href}" class="${classList}" ${disabled ? 'aria-disabled="true" tabindex="-1"' : ''}>${iconBefore}${loader}${children}${iconAfter}</a>`;
  }
}}

<button type={type} class={classList} disabled={disabled || loading} aria-busy={loading}>
  {iconBefore}
  {loader}
  {children}
  {iconAfter}
</button>