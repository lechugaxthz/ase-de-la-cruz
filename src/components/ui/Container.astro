---
interface Props {
  children: any;
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
}
---
{{
  const { children, class: className = '', size = 'lg' } = Astro.props;

  const sizeClasses = {
    sm: 'max-w-3xl',
    md: 'max-w-5xl',
    lg: 'max-w-7xl',
    xl: 'max-w-[90rem]',
    full: 'max-full',
  };
}}
<div class={`mx-auto px-4 sm:px-6 lg:px-8 ${sizeClasses[size]} ${className}`}>
  <slot />
</div>