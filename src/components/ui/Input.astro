---
interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'number' | 'password';
  placeholder?: string;
  value?: string;
  required?: boolean;
  disabled?: boolean;
  error?: string;
  hint?: string;
  class?: string;
  autocomplete?: string;
  pattern?: string;
  min?: string;
  max?: string;
  step?: string;
}
---
{{
  const {
    id,
    name,
    label,
    type = 'text',
    placeholder,
    value,
    required = false,
    disabled = false,
    error,
    hint,
    class: className = '',
    autocomplete,
    pattern,
    min,
    max,
    step,
  } = Astro.props;

  const inputClasses = `
    w-full px-4 py-3 rounded-lg border bg-white text-dark
    focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary
    disabled:bg-surface-alt disabled:cursor-not-allowed
    transition-all duration-200
    ${error ? 'border-error focus:ring-error/30 focus:border-error' : 'border-border'}
    ${className}
  `;

  const labelClasses = `block text-sm font-medium text-dark-light mb-2 ${required ? 'after:content-["*"] after:text-error after:ml-1' : ''}`;
}}
<div class={className}>
  <label for={id} class={labelClasses}>{label}</label>
  <input
    id={id}
    name={name}
    type={type}
    placeholder={placeholder}
    value={value}
    required={required}
    disabled={disabled}
    autocomplete={autocomplete}
    pattern={pattern}
    min={min}
    max={max}
    step={step}
    class={inputClasses}
    aria-invalid={error ? 'true' : 'false'}
    aria-describedby={error ? `${id}-error` : hint ? `${id}-hint` : undefined}
  />
  {error && <p id={`${id}-error`} class="mt-1.5 text-sm text-error" role="alert">{error}</p>}
  {hint && !error && <p id={`${id}-hint`} class="mt-1.5 text-sm text-muted">{hint}</p>}
</div>