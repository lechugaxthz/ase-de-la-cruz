---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { CONTACT, SOCIAL } from '../../lib/constants';
---
<footer class="bg-dark text-white" role="contentinfo">
  <Container>
    <div class="py-16 lg:py-24 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2 font-heading font-extrabold text-2xl mb-6" aria-label="Ase de la Cruz - Inicio">
          <span class="material-symbols-outlined text-3xl text-primary">shield</span>
          <span>Ase de la Cruz</span>
        </a>
        <p class="text-slate-300 leading-relaxed mb-6 max-w-xs">
          Más de 20 años protegiendo el patrimonio de familias y empresas argentinas. Asesoramiento experto, defensa activa y tranquilidad real.
        </p>
        <div class="flex gap-4" role="list" aria-label="Redes sociales">
          {Object.entries(SOCIAL).map(([key, url]) => (
            <a href={url} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-primary hover:text-white transition-all duration-200" aria-label={key} role="listitem">
              {key === 'linkedin' && <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>}
              {key === 'instagram' && <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>}
              {key === 'youtube' && <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>}
            </a>
          ))}
        </div>
      </div>

      <nav aria-label="Servicios">
        <h3 class="font-heading font-bold text-lg mb-4">Servicios</h3>
        <ul class="space-y-3 text-slate-300">
          <li><a href="/servicios?cat=salud" class="hover:text-primary transition-colors">Salud</a></li>
          <li><a href="/servicios?cat=vida" class="hover:text-primary transition-colors">Vida & Ahorro</a></li>
          <li><a href="/servicios?cat=hogar" class="hover:text-primary transition-colors">Hogar & Patrimonio</a></li>
          <li><a href="/servicios?cat=vehicular" class="hover:text-primary transition-colors">Automotores</a></li>
          <li><a href="/servicios?cat=empresas" class="hover:text-primary transition-colors">Empresas</a></li>
          <li><a href="/servicios?cat=art" class="hover:text-primary transition-colors">ART</a></li>
        </ul>
      </nav>

      <nav aria-label="Empresa">
        <h3 class="font-heading font-bold text-lg mb-4">Empresa</h3>
        <ul class="space-y-3 text-slate-300">
          <li><a href="/nosotros" class="hover:text-primary transition-colors">Nosotros</a></li>
          <li><a href="/nosotros#equipo" class="hover:text-primary transition-colors">Equipo</a></li>
          <li><a href="/blog" class="hover:text-primary transition-colors">Blog</a></li>
          <li><a href="/contacto" class="hover:text-primary transition-colors">Contacto</a></li>
        </ul>
      </nav>

      <div>
        <h3 class="font-heading font-bold text-lg mb-4">Contacto</h3>
        <ul class="space-y-3 text-slate-300">
          <li class="flex items-center gap-3">
            <span class="material-symbols-outlined text-primary">place</span>
            <span>Pilar, Buenos Aires</span>
          </li>
          <li class="flex items-center gap-3">
            <a href="tel:{CONTACT.phones[0].number}" class="hover:text-primary transition-colors flex items-center gap-3">
              <span class="material-symbols-outlined text-primary">call</span>
              <span>{CONTACT.phones[0].label}</span>
            </a>
          </li>
          <li class="flex items-center gap-3">
            <a href="mailto:{CONTACT.email}" class="hover:text-primary transition-colors flex items-center gap-3">
              <span class="material-symbols-outlined text-primary">mail</span>
              <span>{CONTACT.email}</span>
            </a>
          </li>
          <li class="flex items-center gap-3">
            <a href="https://wa.me/{CONTACT.phones[0].whatsapp}" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors flex items-center gap-3">
              <span class="material-symbols-outlined text-primary">chat</span>
              <span>WhatsApp</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-slate-800 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-slate-400 text-sm">
        © {new Date().getFullYear()} Ase de la Cruz. Todos los derechos reservados.
      </p>
      <div class="flex gap-6 text-sm text-slate-400">
        <a href="/privacidad" class="hover:text-primary transition-colors">Política de Privacidad</a>
        <a href="/terminos" class="hover:text-primary transition-colors">Términos y Condiciones</a>
      </div>
    </div>
  </Container>
</footer>
